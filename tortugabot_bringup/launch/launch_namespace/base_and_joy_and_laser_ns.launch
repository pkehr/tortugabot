<?xml version="1.0" encoding="utf-8"?>
<launch>
<arg name="use_ns" default="true"/>
<group ns="turtle" if="$(arg use_ns)">
  <arg name="tf_prefix" default="turtle"/>
  <param name="turtle_tf_prefix" type="string" value="$(arg tf_prefix)" />
  <include file="$(find tortugabot_bringup)/launch/launch_namespace/base_and_joy_ns.launch" pass_all_args="true"/>
  <include file="$(find tortugabot_bringup)/launch/launch_namespace/laser_ns.launch" pass_all_args="true"/>
</group>
</launch>
